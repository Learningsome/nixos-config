layout {

    focus-ring {
        active-color   "#c1ae8b"
        inactive-color "#23201a"
        urgent-color   "#fd4663"
    }

    border {
        active-color   "#c1ae8b"
        inactive-color "#23201a"
        urgent-color   "#fd4663"
    }


    tab-indicator {
        active-color   "#c1ae8b"
        inactive-color "#6a552f"
        urgent-color   "#fd4663"
    }

    insert-hint {
        color "#c1ae8b80"
    }
}

recent-windows {
    highlight {
        active-color "#c1ae8b"
        urgent-color "#fd4663"
    }
}
